# Video Studio API
API_KEY=replace-with-a-long-random-secret
DATABASE_PATH=./data/jobs.sqlite3
OUTPUT_DIR=./output
ALLOWED_ORIGINS=http://localhost:8000

# Facebook Hub (uses API_KEY above if FACEBOOK_HUB_API_KEY is omitted)
# Set a separate key if you want to isolate Hub access.
FACEBOOK_HUB_API_KEY=
# Optional separate SQLite database; otherwise Hub tables share DATABASE_PATH.
FACEBOOK_HUB_DB=

# Optional OpenAI-compatible AI provider for Facebook Hub rewriting.
# Use a provider you trust; requests send public RSS titles and short excerpts.
# Leave all three blank to disable AI rewriting (free/no-key operation remains available).
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Meta OAuth for connecting Facebook Pages (server-side only)
# Create an app in Meta for Developers and configure this exact callback URL
# in the Facebook Login product. Never put APP_SECRET or Page tokens in the browser.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://your-domain.example/api/facebook-hub/meta/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key persistent and backed up; changing it makes stored Page tokens unreadable.
META_TOKEN_ENCRYPTION_KEY=
# Current Graph API version used by this integration; override only after checking Meta docs.
META_GRAPH_API_VERSION=v27.0
