# Required before enabling job creation. Use a long random secret.
API_KEY=replace-with-a-long-random-secret

# Comma-separated exact frontend origins.
ALLOWED_ORIGINS=https://minhthuan2006qb-create.github.io

# Persistent path; mount a volume at this location on the VPS.
DATABASE_PATH=/app/data/jobs.sqlite3
OUTPUT_DIR=/app/output
